---
import Bubble from '../components/cursorTrail.astro';
import fishImg from '../assets/sketchy_fish.svg';
import Music from '../components/musicPlayer.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<!-- /* TEMPORARY-ASSET-BELOW */ -->
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>Bec!</title>
	</head>
	<body>
		<slot />

<Music />

<div class="flexTable">
	<div class="col-3">
		<img src={fishImg.src} class="scaleImg">
	</div>
	<div class="col-6">
		<p class="pixelH">Column Header</p>
		<p class="redhatBody">Some text..</p>
	</div>
	<div class="col-3">
		<img src={fishImg.src} class="flipScaleImg">
	</div>
</div>

 <Bubble />
</body>
</html>

<style>

	#container {
		font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
		/* TEMPORARY-ASSET-BELOW */
		/* background-image: url('../assets/background_placeholder.gif');  */
		/* background: linear-gradient(20deg, #141528 0%, #8839a5 100%); */
		background-size: cover; 
		height: 100%;
	}

	img.flipScaleImg {
		transform: rotate(180deg);
		width: 100%;
		pointer-events: none;
	}

	img.scaleImg{
		width: 100%;
		pointer-events: none;
	}

	.centerPage {
		position: fixed;
		top: 40%;
		left: 50%;
		transform: translateX(-50%) translateY(-50%);
		width: 100%;
		text-align: center;

		/* add "glow" to the text */
		/* filter: drop-shadow(0px 0px 10px white);  */
	}

	main {
		height: 100%;
		display: flex;
		justify-content: center;
	}

	#hero {
		display: flex;
		align-items: center; 
		flex-direction: column;
		justify-content: center;
		padding: 16px;
	}

	#links {
		display: flex;
		gap: 16px;
		margin-top: 0.25em;
	}

	h2 {
		margin: 0 0 1em;
		font-weight: normal;
		color: #111827;
		font-size: 20px;
	}

	p {
		color: #4b5563;
		font-size: 16px;
		line-height: 24px;
		letter-spacing: -0.006em;
		margin: 0;
		cursor: url("../assets/cursor/textLight.cur"), auto;
		width: auto;
		text-align: center;
		padding: 0.5em 0;
	}

</style>
