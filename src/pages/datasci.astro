                    <Project />
            </div>
            <div class="col-1">
                <div class="soc-bar">
                    <button class="soc-button">
                        [github]
                        <span class="soc-button-text">Visit my Github</span>
                    </button>
                    <button class="soc-button">
                        [linkedin]
                        <span class="soc-button-text">Connect with me on LinkedIn</span>
                    </button>
