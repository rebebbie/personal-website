<style>
img.pfp{
    display: inline-flex;
    width:80%;
    height:auto;
    margin:10px;
    filter: drop-shadow(-5px 5px 0px #81559B); 
}
.profile-box{
    display: inline-flex;
    flex-wrap: wrap;
    justify-content: center;
    width:80%;
	border-style: solid;
	border-width: 2px;
	border-radius: 8px; 
	border-color: #81559B;
	padding-left: 20px; 
	padding-right: 20px;
}
.content-box{
    display: flex;
	border-style: solid;
	border-width: 2px;
	border-radius: 8px; 
	border-color: #81559B;
	padding-left: 20px; 
	padding-right: 20px;
    margin-left: 20px;
}

.nav-button-wrapper{
    color:aliceblue;
    display: inline-flex;
    position:relative;
}
.nav-button-wrapper::before{
    position: absolute;
  bottom: 0;
  left: -20px;
  content: '';
  width:125%;
  height:80%;
  background-color: #B9D996;
  /* E0D3DE 81559B B9D996*/
  visibility: hidden;
  border-radius: 20rem 0 20rem 0;
}
.nav-button-wrapper::after{
  position: absolute;
  bottom: 0;
  left: -20px;
  content: '';
  width:125%;
  height:80%;
  background-color: #81559B;
  z-index: -1;
  visibility: hidden;
  border-radius: 20rem 0 20rem 0;
}
.nav-button-wrapper:hover:before{
    visibility: visible;
    animation: jelly-anim-bg 3s infinite ease-in-out alternate;
    z-index:2
}
.nav-button-wrapper:hover:after {
    visibility: visible;
    animation: jelly-anim 3s infinite ease-in-out alternate;
    z-index:3;
}
.nav-button-img{
    z-index:100;
}

@keyframes jelly-anim-bg {
    0%{
        border-radius: 30% 70% 70% 30% / 70% 50% 50% 30% ;
    }
    100%{
        border-radius: 65% 35% 38% 62% / 71% 28% 72% 29% ;
    }
}
@keyframes jelly-anim {
    0%{
        border-radius: 50% 50% 52% 48% / 52% 51% 49% 48% ;
    }
    20%{
        border-radius: 59% 41% 62% 38% / 47% 53% 47% 53% ;
    }
    40%{
        border-radius: 65% 35% 70% 30% / 34% 62% 38% 66% ;
    }
    60%{
        border-radius: 54% 46% 60% 40% / 26% 72% 28% 74% ;
    }
    80%{
        border-radius: 45% 55% 68% 32% / 26% 59% 41% 74% ;
    }
    100%{
        border-radius: 45% 55% 60% 40% / 60% 37% 63% 40% ;
    }
}

</style>