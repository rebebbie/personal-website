---
import Bubble from '../components/cursorTrail.astro';
import Music from '../components/musicPlayer.astro';
import Project from '../components/datasci-content.astro';
import SocBar from '../components/socbar.astro';
import Star1 from '../assets/datasci-images/star1.svg';
import Star2 from '../assets/datasci-images/star2.svg';
import Star3 from '../assets/datasci-images/star3.svg';
import Star4 from '../assets/datasci-images/star4.svg';
import Star5 from '../assets/datasci-images/star5.svg';
import '../styles/global.css';
---

<!-- 
	TODO:
    - when navigating between pages of this website, in order to keep the music playing,
      I might have to just unload the content ONLY and then re-load the new content. 
      see if this is possible using astro components and js
-->

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href='src/assets/emolga.gif' />
		<meta name="generator" content={Astro.generator} />
		<title>Bec!</title>
	</head>
	<body>
        <Music />
        <Bubble />
        <div class="flexTable">
            <div class="col-1"></div>
            <div class="col-2"> 
                <div class="left-sidebar-wrapper">
                <div class="profile-box">
                    <img class="pfp" src="src/assets/datasci-images/test-pfp.png">
                    <p class="pixelCons">
                        Hi, I'm <a class="pixelCode">Rebecca</a>!
                    </p>
                    <p class="pixelCons">
                        Thanks for visiting my website. Enjoy your stay!
                    </p>
                </div>
                
                <a class="nav-button-wrapper" id="nav-projects">
                    <!-- TEMPORARY-ASSET-BELOW -->
                    <!-- PROJECTS -->
                    <img class="nav-button-img" src="https://i.imgur.com/H4JD35M.png"> 
                    <img src={Star1.src}  class="deco" id="star-deco1"> 
                    <img src={Star2.src}  class="deco" id="star-deco2"> 
                    <img src={Star3.src}  class="deco" id="star-deco3"> 
                    <img src={Star4.src}  class="deco" id="star-deco4"> 
                    <img src={Star5.src}  class="deco" id="star-deco5"> 

                </a>
                <a class="nav-button-wrapper" id="nav-experiences">
                    <!-- TEMPORARY-ASSET-BELOW -->
                     <!-- EXPERIENCES -->
                    <img class="nav-button-img" src="https://i.imgur.com/H4JD35M.png"> 
                </a>
                <a class="nav-button-wrapper">
                    <!-- TEMPORARY-ASSET-BELOW -->
                     <!-- CERTIFICATIONS -->
                    <img class="nav-button-img" src="https://i.imgur.com/H4JD35M.png"> 
                </a>

                <p><a class="pixelCode">Return to landing page</a></p>
                </div>
            </div>
            <div class="col-8"> 
                    <Project />
            </div>
            <div class="col-1">
            </div>
                <SocBar/>
        </div>
    </body>
</html>

<script type="text/javascript">
    let s1 = document.getElementById("star-deco1");
    let s2 = document.getElementById("star-deco2");
    let s3 = document.getElementById("star-deco3");
    let s4 = document.getElementById("star-deco4");
    let s5 = document.getElementById("star-deco5");
    let s = [s1,s2,s3,s4,s5];
    let navButton = document.getElementById("nav-projects");
    let currButton = "nav-projects";
    let navRect = navButton.getBoundingClientRect();
    let time;

    window.addEventListener("load", () => {
		updateStars(currButton);

        for (let i = 0; i < 5; i++) {
            time = Math.random() + 1;
            s[i].style.setProperty('--animation-time',time+'s');
        }
	});

    window.addEventListener("resize", (e) => {
        updateStars(currButton);
    });

    function changeButton(destButton){
        currButton=destButton;
        updateStars(currButton);
    }

    //for some reason it's ... one below what it should be
    function updateStars(destButton) {
        navButton = document.getElementById(destButton);
        navRect = navButton.getBoundingClientRect();
        s1.style.left=(navRect.left-20)+'px';
        s1.style.top=(navRect.top+5)+'px';
        s2.style.left=(navRect.left-10)+'px';
        s2.style.top=(navRect.top+15)+'px';
        s3.style.left=(navRect.right-10)+'px';
        s3.style.top=navRect.top+'px';
        s4.style.left=(navRect.right)+'px';
        s4.style.top=(navRect.top+10)+'px';
        s5.style.left=(navRect.right-10)+'px';
        s5.style.top=(navRect.top+20)+'px';
        console.log(navRect.top, navRect.right, navRect.bottom, navRect.left);
	}

</script>

<style>
img.pfp{
    display: inline-flex;
    width:80%;
    height:auto;
    margin:10px;
    filter: drop-shadow(-5px 5px 0px #81559B); 
}
.profile-box{
    display: block;
    flex-wrap: wrap;
    justify-content: center;
    text-align: center;
    width:80%;
	border-style: solid;
	border-width: 2px;
	border-radius: 8px; 
	border-color: #81559B;
    background-color:black;
    margin-bottom:20px;
	padding-left: 20px; 
	padding-right: 20px;
}


.nav-button-wrapper{
    color:aliceblue;
    display: inline-flex;
    position:relative;
    --animation-time: 2s;
}
.nav-button-wrapper::before{
    position: absolute;
  bottom: 0;
  left: -20px;
  content: '';
  width:125%;
  height:80%;
  background-color: #B9D996;
  /* E0D3DE 81559B B9D996*/
  visibility: hidden;
  border-radius: 20rem 0 20rem 0;
}
.nav-button-wrapper::after{
  position: absolute;
  bottom: 0;
  left: -20px;
  content: '';
  width:125%;
  height:80%;
  background-color: #81559B;
  z-index: -1;
  visibility: hidden;
  border-radius: 20rem 0 20rem 0;
}
.nav-button-wrapper:hover:before{
    visibility: visible;
    animation: jelly-anim-bg 3s infinite ease-in-out alternate;
    z-index:2
}
.nav-button-wrapper:hover:after {
    visibility: visible;
    opacity: 0.8;
    animation: jelly-anim 3s infinite ease-in-out alternate;
    z-index:3;
}
.nav-button-img{
    z-index:100;
}
.nav-button-wrapper:hover .nav-button-img{
    transform: rotate(-6deg);
}
.deco{
    width:20px;
    z-index:500;
    position:fixed;
    bottom:10px;
    left:20px;

  -webkit-animation: rotating var(--animation-time) linear infinite alternate;
  -moz-animation: rotating var(--animation-time) linear infinite alternate;
  -ms-animation: rotating var(--animation-time) linear infinite alternate;
  -o-animation: rotating var(--animation-time) linear infinite alternate;
  animation: rotating var(--animation-time) linear infinite alternate;
}

@keyframes jelly-anim-bg {
    0%{
        border-radius: 30% 70% 70% 30% / 70% 50% 50% 30% ;
    }
    100%{
        border-radius: 65% 35% 38% 62% / 71% 28% 72% 29% ;
    }
}
@keyframes jelly-anim {
    0%{
        border-radius: 50% 50% 52% 48% / 52% 51% 49% 48% ;
    }
    20%{
        border-radius: 59% 41% 62% 38% / 47% 53% 47% 53% ;
    }
    40%{
        border-radius: 65% 35% 70% 30% / 34% 62% 38% 66% ;
    }
    60%{
        border-radius: 54% 46% 60% 40% / 26% 72% 28% 74% ;
    }
    80%{
        border-radius: 45% 55% 68% 32% / 26% 59% 41% 74% ;
    }
    100%{
        border-radius: 45% 55% 60% 40% / 60% 37% 63% 40% ;
    }
}

@-webkit-keyframes rotating /* Safari and Chrome */ {
  from {
    -webkit-transform: rotate(0deg) scale(1);
    -o-transform: rotate(0deg) scale(1);
    transform: rotate(0deg) scale(1);
  }
  to {
    -webkit-transform: rotate(360deg) scale(0.35);
    -o-transform: rotate(360deg) scale(0.35);
    transform: rotate(360deg scale(0.35));
  }
}
@keyframes rotating {
  from {
    -ms-transform: rotate(0deg) scale(1);
    -moz-transform: rotate(0deg) scale(1);
    -webkit-transform: rotate(0deg) scale(1);
    -o-transform: rotate(0deg) scale(1);
    transform: rotate(0deg) scale(1);
  }
  to {
    -ms-transform: rotate(360deg) scale(0.35);
    -moz-transform: rotate(360deg) scale(0.35);
    -webkit-transform: rotate(360deg) scale(0.35);
    -o-transform: rotate(360deg) scale(0.35);
    transform: rotate(360deg) scale(0.35);
  }
}

</style>