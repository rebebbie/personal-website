---
import Bubble from '../components/cursorTrail.astro';
import fishImg from '../../public/assets/fish.svg';
import Music from '../components/musicPlayer.astro';
import Terminal from '../components/terminal.astro';
import MobileTerminal from '../components/mterminal.astro';
import '../styles/global.css';
---

<!-- 
	TODO:
-->

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<link rel="icon" type="image/svg+xml" href='src/assets/emolga.gif' />
		<meta name="generator" content={Astro.generator} />
		<title>Bec!</title>
	</head>
	<body>

<Bubble />

<div class="desktop">
	<Music />
	<div class="flexTable">
		<div class="col-3"> 
			<img src={fishImg.src} class="scaleImg"> 
		</div>
		<div class="col-6">
			<p class="iam-name">REBECCA <b>若汐</b> HAN</p>
			<p class="iam-text" id="iam"></p>
			<Terminal />
		</div>
		<div class="col-3">
			<img src={fishImg.src} class="flipScaleImg">
		</div>
	</div>
</div>

<div class="mobile">
	<p class="iam-name">REBECCA <b>若汐</b> HAN</p>
	<p class="iam-text" id="iam-mobile"></p>
	<MobileTerminal />
</div>

<div class="top-scroll-button">
	<a class="pixelEm" onclick="topFunction()"><i><u>Scroll to top</u></i></a>
</div>
</body>
</html>

<script type="text/javascript">
	let iamtext;
	let vw = Math.max(document.documentElement.clientWidth || 0, window.innerWidth || 0);
	if (vw<=1280){
		iamtext = document.getElementById("iam-mobile");
	}
	else{
		iamtext = document.getElementById("iam");
	}
	function topFunction() {
		window.scrollTo({top:0, behavior: 'smooth'});
	}
	
	window.addEventListener("load", () => {
		loopText(texts[textIndex]);
	});

	const texts=[
		"Data Analyst", "Machine Learning Specialist", "IT Professional", "Data Scientist", "Fullstack Developer"
	];
		
	let textIndex = 0;
	function loopText(t) {
		console.log(t);
		typeWriter(t);
	}

	let i = 0;
	function typeWriter(t) {
		let txt = String(t);
		if (i >= txt.length){
			setTimeout(function() {
				deleteWriter(t);
			}, 750);
		}
		else {
			iamtext.innerHTML += txt.charAt(i++);
			setTimeout(function() {
				typeWriter(t);
			}, Math.random() * (200 - 50) + 50);
		}
	}
	function deleteWriter(t) {
		let txt = String(t);
		if (i < 0){
			textIndex++; 
			loopText(texts[textIndex%texts.length]); 
		}
		else{
			iamtext.innerHTML = txt.slice(0, i--);
			setTimeout(function() {
				deleteWriter(t);
			}, Math.random() * (200 - 50) + 50);
		}
	}

	window.addEventListener("resize", () => {
		console.log("detecting resize");

		let vw = Math.max(document.documentElement.clientWidth || 0, window.innerWidth || 0);
		// let vh = Math.max(document.documentElement.clientHeight || 0, window.innerHeight || 0);
		if (vw<=1280){
			iamtext = document.getElementById("iam-mobile");
		}
		else{
			iamtext = document.getElementById("iam");
		}

		// min width vw is 1280 for desktop view
	})

	
</script>

<style>

	#container {
		font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
		background-size: cover; 
		height: 100%;
	}

	/* default */
	.desktop {
		display: block;
	}
	.mobile {
		display: none;
	}
	/* end default */

	/* mobile-only */
	@media (max-width: 1280px) {
		.desktop {
			display: none;
		}
		.mobile {
			display: block;
		}
	}
	/* end mobile only */

	img.flipScaleImg {
		height: 80%;
		width:auto;
		max-width: 100%;
		position: fixed;
		display: flex;
		transform: rotate(180deg);
		pointer-events: none;
	}

	img.scaleImg{
		height: 80%;
		width:auto;
		max-width: 100%;
		position:fixed;
		display: flex;
		pointer-events: none;
	}

	.centerPage {
		position: fixed;
		top: 40%;
		left: 50%;
		transform: translateX(-50%) translateY(-50%);
		width: 100%;
		text-align: center;

		/* add "glow" to the text */
		/* filter: drop-shadow(0px 0px 10px white);  */
	}

	main {
		height: 100%;
		display: flex;
		justify-content: center;
	}

	#hero {
		display: flex;
		align-items: center; 
		flex-direction: column;
		justify-content: center;
		padding: 16px;
	}

	#links {
		display: flex;
		gap: 16px;
		margin-top: 0.25em;
	}

	h2 {
		margin: 0 0 1em;
		font-weight: normal;
		color: #111827;
		font-size: 20px;
	}

	p {
		cursor: url("assets/cursor/textLight.cur"), auto;
	}

	.top-scroll-button{
		position: fixed;
		bottom: 0;
		right: 0;
		text-align: right;
		width: 300px;
		margin: 10px 30px 10px 10px;
	}

</style>
