---
import socImg1 from '../assets/datasci-images/soc-git.svg';
import socImg2 from '../assets/datasci-images/soc-in.svg';
import socImg3 from '../assets/datasci-images/soc-res.svg';
---

<!-- TODO:
        - soc buttons
            - for some reason the active (click) animation is slow.
 -->

<div class="soc-bar" id="socialsBar">
    <button class="soc-button" onclick="linkout('g')">
        <span class="soc-button-text">Visit my Github</span>
        <img src={socImg1.src}  class="soc-icon"> 
    </button>
    <button class="soc-button" onclick="linkout('l')">
        <span class="soc-button-text">Connect with me on LinkedIn</span>
        <img src={socImg2.src}  class="soc-icon" style="transform:scale(1.25);"> 
    </button>
    <button class="soc-button" onclick="linkout('r')">
        <span class="soc-button-text">Download my resume</span>
        <img src={socImg3.src}  class="soc-icon"> 
    </button>
</div>

<script type="text/javascript">
    let socBox = document.getElementById("socialsBar");  
    function linkout(s) {
        let outlink = document.createElement("a");
        if(s == 'g'){
            outlink.href = "https://github.com/rebebbie";
            outlink.target="_blank";
        }
        if(s == 'l'){
            outlink.href = "https://www.linkedin.com/in/rebecca-ruoxi-han/";
            outlink.target="_blank";
        }
        else if(s == 'r'){
            outlink.href = "src/assets/resume.pdf";
            outlink.download = "Rebecca Han Resume";
        }
        socBox.appendChild(outlink);
        outlink.click();
        outlink.remove();
    }
</script>

<style>
    .soc-button-text{
        display:none;
        margin-right:8px;
    }
.soc-bar{
	position: fixed;
    width: auto;
    min-width:100px;
    max-width:500px;
    display:flex;
    justify-content: flex-end;
    align-items: flex-end;
    flex-wrap:wrap;
    flex-direction: column;
    bottom: 38%;
    right:2%;
	z-index: 1000;
}
.soc-button{
	/* position: absolute; */
    /* width: 50%; */
	height: 35px;
    width: 35px;
    min-width:35px;
    max-width:35px;
    overflow:hidden;
	/* width: 50px; */
    
        display:flex;
align-items: center;
/* max-width:35px; */
    outline: none;
    background-color:#E0D3DE;
    font-family: "pixelHeader", Verdana, Tahoma;
	color: #81559B;
    border: none;
    border-radius: 8px;
	margin: 10px 20px 0px 20px;
	padding-top:10px;
	padding-bottom:10px;
    filter: drop-shadow(-2px 3px 0 #81559B);
} 
.soc-button:hover{
	width:fit-content;
    max-width:200px;
    -webkit-transition: 0.35s ease-in-out;
    transition: 0.35s ease-in-out;
}
.soc-button:hover .soc-button-text{
    display: inline-flex;
}
.soc-button:active{
    transform: translate(-2px,2px);
    -webkit-transition: 0.1s;
    transition: 0.1s;
    filter: drop-shadow(0px 0px 0 #E0D3DE);
}
.soc-icon{
    width:25px;
}
</style>