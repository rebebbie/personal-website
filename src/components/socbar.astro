    display:inline-flex;
  visibility: hidden;
  width: 120px;
  background-color: #14110F;
  color: #fff;
  text-align: center;
  border-radius: 6px;
  padding: 5px 0;
  filter: drop-shadow(px 0px 1px #E0D3DE);
  
  (Position the tooltip)
  position: absolute;
  z-index: 1;
  top: -3px; 
  right: 105%;
} */
/* .soc-button:hover .soc-button-text{
	visibility: visible;
} */
.soc-button:active{
    transform: translate(-2px,2px);
	color: #E0D3DE;
    filter: drop-shadow(0px 0px 0 #E0D3DE);
}
.soc-icon{
    width:25px;
}
</style>