---
import backImg from '../assets/music/back-light.svg';
import forwImg from '../assets/music/forw-light.svg';
import muteImg from '../assets/music/mute-light.svg';
import songTest from '../assets/music/songs/testsong.mp3';

---

<!-- 

PROGRESS AND TODO:
    - basic single song functionality is good
    - some styling (spacing etc.) still needs to be adjusted. just details though
    - NEEDS PLAYLIST FEATURE. currently can only play one song

-->

<div class="musicPlayer">	
    <div class="musicBarBox">
        <div class="musicControls">
            <div class="prev-song" onclick="prevSong()">
                <img src={backImg.src} class="musicButton">
            </div>
            <div class="play-song" onclick="playPauseSong()" id="playPause">
                <img class="playButton">
            </div>
            <div class="next-song" onclick="nextSong()">
                <img src={forwImg.src} class="musicButton">
            </div>
        </div>
        <div>
		    <p><a class="pixelEm"><i>placeholder for SONG TITLE and ARTIST NAME</i></a></p>
	    </div>
        <audio id="curSong">
            <source src={ songTest } type="audio/mpeg">
            <p><a class="pixelEm">[Your browser does not support the audio element.]</a></p>
        </audio>
        <input type = "range" value="0" id="musicBar">

        <div class="musicControls">
            <div class="mute-song" onclick="mutePlaySong()" id="mutePlay">
                <!-- NOTE: I switched the mute and speaker button names -->
                <!-- so muteButton has the asset for speaker and vice versa -->
                <!-- it was a little bit of shoddy code but eh it works -->
                <img class="muteButton">
            </div>
        </div>
        <input type = "range" value="20" id="volumeBar">
	</div>
    </div>

    <script type="text/javascript">
        let progress = document.getElementById("musicBar");
        let song = document.getElementById("curSong");
        let playpause = document.getElementById("playPause");
        let songMute = document.getElementById("mutePlay");
        let songVol = document.getElementById("volumeBar");

        song.onloadedmetadata = function(){
            // for progress bar to work properly
            progress.max = curSong.duration;
            progress.value = curSong.currentTime;
            playpause.classList.add("playButton");
            
            // audio setup for on-load behaviour 
            song.volume=0.2; //can remove later
            songMute.classList.add("muteButton");
            songVol.max = 100;
        }

        function playPauseSong(){
            if(playpause.classList.contains("pauseButton")){
                song.pause();
                playpause.classList.remove("pauseButton");
                playpause.classList.add("playButton");
            }
            else{
                song.play();
                playpause.classList.remove("playButton");
                playpause.classList.add("pauseButton");
            }
        }

        function mutePlaySong(){
            if(songMute.classList.contains("muteButton")){
                song.volume = 0;
                songMute.classList.remove("muteButton");
                songMute.classList.add("speakerButton");
            }
            else{
                song.volume = songVol.value/100;
                songMute.classList.remove("speakerButton");
                songMute.classList.add("muteButton");
            }
        }

        if(song.play()){
            setInterval(()=>{
                progress.value = song.currentTime;
            },500)
        }

        progress.onchange = function(){
            song.play();
            song.currentTime = progress.value;
            playpause.classList.remove("playButton");
            playpause.classList.add("pauseButton");
        }

        songVol.onchange = function(){
            if(songVol.value<=2){
                song.volume = 0;
                songMute.classList.remove("muteButton");
                songMute.classList.add("speakerButton");
            }
            else{
                song.volume=songVol.value/100;
                songMute.classList.remove("speakerButton");
                songMute.classList.add("muteButton");
            }
        }
    </script>

</div>

<style>
	.musicPlayer {
		width: 100%;
		height: 70px;
		left: 0;
		padding-bottom: 30px;
   		display: flex;
        justify-content: space-between;
        align-content: flex;
	}
    .musicControls{
        display: flex;
        justify-content: center;
        align-items: center;
    }
	.musicButton{
		width: 30px;
		padding-left: 1em;
		padding-right: 1em;
	}
    .playButton {
        content: url('src/assets/music/play-light.svg');
		width: 30px;
		padding-left: 1em;
		padding-right: 1em;
    }
    .pauseButton {
        content: url('src/assets/music/pause-light.svg');
		width: 30px;
		padding-left: 1em;
		padding-right: 1em;
    }
    .muteButton {
        content: url('src/assets/music/speaker-light.svg');
		width: 30px;
		padding-left: 1em;
		padding-right: 1em;
    }
    .speakerButton {
        content: url('src/assets/music/mute-light.svg');
		width: 30px;
		padding-left: 1em;
		padding-right: 1em;
    }
    .musicBarBox {
        background: transparent;
        display: flex;
        justify-content: space-evenly;
        align-items: center;
        padding: 7px;
        width: 100%;
    }
	#musicBar {
        -webkit-appearance: none;
        width: 50%;
        height: 6px;
        background: #B9D996; 
        border-radius: 5px;
		cursor: url("../assets/cursor/normalLight.cur"), auto;
        display: flex;
        justify-content: space-evenly;
	}
    #musicBar::-webkit-slider-thumb {
        -webkit-appearance: none;
        background-image: url("../assets/solosis.gif");
        background-size: 30px;
        width:30px;
        height:30px;
    }
    #volumeBar {
        -webkit-appearance: none;
        width: 10%;
        height: 6px;
        background: #B9D996; 
        border-radius: 5px;
		cursor: url("../assets/cursor/normalLight.cur"), auto;
        display: flex;
        justify-content: space-evenly;
	}
    #volumeBar::-webkit-slider-thumb {
        -webkit-appearance: none;
        background-image: url("../assets/tynamo.gif");
        background-size: 30px 20px;
        margin-left: -10px;
        width:30px;
        height:20px;
    }
</style>