---
import songTest from '../assets/music/songs/testsong.mp3';
---

<!-- 

PROGRESS AND TODO:
    - potentially loads slow bc theres hella mb from songs
    - make bar sticky
-->

<div class="musicPlayer">	
    <div class="musicBarBox">
        <div class="musicControls">
            <button class="prev-song-btn" onclick="prevSong()" id="playBack">
                <img class="backButton">
            </button>
            <button class="play-song-btn" onclick="playPauseSong()" id="playPauseButton">
                <img class="playButton" id="playPause">
            </button>
            <button class="next-song-btn" onclick="nextSong()" id="playNext">
                <img class="nextButton">
            </button>
        </div>
        <div>
		    <p class="songNameTitle"><a class="pixelEm" id="songName"><i></i></a></p>
	    </div>
        <audio id="curSong">
            <source src={ songTest } type="audio/mpeg" id="curSongSrc">
            <p><a class="pixelEm">[Your browser does not support the audio element.]</a></p>
        </audio>
        <input type = "range" value="0" id="musicBar">

        <div class="musicControls">
            <button class="mute-song" onclick="mutePlaySong()" id="mutePlayButton">
                <!-- NOTE: I switched the mute and speaker button names -->
                <!-- so muteButton has the asset for speaker and vice versa -->
                <!-- it was a little bit of shoddy code but eh it works -->
                <img class="muteButton" id="mutePlay">
            </button>
        </div>
        <input type = "range" value="20" id="volumeBar">
	</div>
    </div>

    <script type="text/javascript">
        let progress = document.getElementById("musicBar");
        let song = document.getElementById("curSong");
        let songSrc = document.getElementById("curSongSrc");
        let playpause = document.getElementById("playPause");
        let playPauseB = document.getElementById("playPauseButton");
        let name = document.getElementById("songName");
        let songMute = document.getElementById("mutePlay");
        let songMuteB = document.getElementById("mutePlayButton");
        let songVol = document.getElementById("volumeBar");


        const songs = [
            {
                source: "/src/assets/music/songs/test.mp3",
                name: "temp song",
                artist: "temp artist"
            },
            {
                source: "/src/assets/music/songs/01-dreamboat.mp3",
                name: "Dream Boat",
                artist: "Evan(gelina)"
            },
            {
                source: "/src/assets/music/songs/02-goodenough.mp3",
                name: "Good enough",
                artist: "Xdinary Heroes"
            },
            {
                source: "/src/assets/music/songs/03-petalsmoon.mp3",
                name: "Petals on the Moon",
                artist: "Wasia Project"
            },
            {
                source: "/src/assets/music/songs/04-dirtychai.mp3",
                name: "Dirty Chai",
                artist: "Sunset Arcade"
            },
            {
                source: "/src/assets/music/songs/05-lovewins.mp3",
                name: "Love wins all",
                artist: "IU"
            },
            {
                source: "/src/assets/music/songs/06-manhattan.mp3",
                name: "Manhattan-Kaboul",
                artist: "Renaud, Axelle Red"
            },
            {
                source: "/src/assets/music/songs/07-contemplate.mp3",
                name: "Contemplate",
                artist: "Funk Fiction"
            },
            {
                source: "/src/assets/music/songs/08-danser.mp3",
                name: "je sais pas danser",
                artist: "Pomme"
            },
            {
                source: "/src/assets/music/songs/09-sofia.mp3",
                name: "Sofia",
                artist: "Clairo"
            },
            {
                source: "/src/assets/music/songs/10-spaceoddity.mp3",
                name: "Space Oddity (2015 Remaster)",
                artist: "David Bowie"
            },
            {
                source: "/src/assets/music/songs/11-nothingelse.mp3",
                name: "nothing else i could do",
                artist: "ella jane"
            },
            {
                source: "/src/assets/music/songs/12-fuzzydisco.mp3",
                name: "Fuzzy Disco",
                artist: "Talkie"
            },
            {
                source: "/src/assets/music/songs/13-knowme.mp3",
                name: "Know me",
                artist: "GEMINI"
            },
            {
                source: "/src/assets/music/songs/14-everythinggoes.mp3",
                name: "Everything Goes On",
                artist: "Porter Robinson, League of Legends"
            },
            {
                source: "/src/assets/music/songs/15-buttons.mp3",
                name: "buttons",
                artist: "Lyn Lapid"
            }
        ]

        let index = 0;
        songSrc.src = songs[index].source;

        song.onloadedmetadata = function(){
            // for progress bar to work properly
            progress.max = curSong.duration;
            progress.value = curSong.currentTime;
            playpause.classList.add("playButton");
            
            // audio setup for on-load behaviour 
            song.volume = songVol.value/100;
            songMute.classList.add("muteButton");
            songVol.max = 100;
            var color = 'linear-gradient(90deg,rgb(224,211,222)'+song.volume*100+'%, rgb(129,85,155)'+song.volume*100+'%)';
            songVol.style.background=color;
            name.innerHTML= "<i>" + songs[index].name + " - " + songs[index].artist + "</i>";
        }

        function playPauseSong(){
            if(playpause.classList.contains("pauseButton")){
                song.pause();
                playpause.classList.remove("pauseButton");
                playpause.classList.add("playButton");
            }
            else{
                song.play();
                playpause.classList.remove("playButton");
                playpause.classList.add("pauseButton");
            }
            playPauseB.blur();
        }

        function mutePlaySong(){
            if(songMute.classList.contains("muteButton")){
                song.volume = 0;
                songMute.classList.remove("muteButton");
                songMute.classList.add("speakerButton");
            }
            else{
                song.volume = songVol.value/100;
                songMute.classList.remove("speakerButton");
                songMute.classList.add("muteButton");
            }
            songMuteB.blur();
        }

        function nextSong(){
            index = (index + 1)%songs.length;
            songSrc.src = songs[index].source;
            song.load();
            song.play();
            playpause.classList.remove("playButton");
            playpause.classList.add("pauseButton");
        }
        function prevSong(){
            index = Math.max((index - 1)%songs.length,0);
            songSrc.src = songs[index].source;
            song.load();
            song.play();
            playpause.classList.remove("playButton");
            playpause.classList.add("pauseButton");
        }

        if(song.play()){
            setInterval(()=>{
                progress.value = song.currentTime;
                if((progress.max-progress.value)<1){
                    nextSong();
                }
            },500)
        }

        progress.oninput = function(){
            song.play();
            song.currentTime = progress.value;
            playpause.classList.remove("playButton");
            playpause.classList.add("pauseButton");
        }

        songVol.oninput = function(){
            if(songVol.value<=2){
                song.volume = 0;
                songMute.classList.remove("muteButton");
                songMute.classList.add("speakerButton");
            }
            else{
                song.volume=songVol.value/100;
                songMute.classList.remove("speakerButton");
                songMute.classList.add("muteButton");
                var color = 'linear-gradient(90deg,rgb(224,211,222)'+song.volume*100+'%, rgb(129,85,155)'+song.volume*100+'%)';
                songVol.style.background=color;
            }
        }
    </script>

</div>

<style>
	.musicPlayer {
		width: 100%;
		height: 50px;
        /* position: fixed;
		bottom: 0; */
		padding: 10px 0px 20px 0px;
        margin-top: 10px;
   		display: flex;
        justify-content: center;
        align-content: center;
	}
    .musicControls{
        display: flex;
        height: 35px;
        align-items: center;
        /* border: solid #E0D3DE; */
        /* border-radius: 10px; */
    }
    .musicControls:nth-child(2){
        transform: scale(2.5);
    }
	.musicButton{
		width: 30px;
		padding-left: 1em;
		padding-right: 1em;
	}
    .playButton {
        content: url('src/assets/music/play-light2.svg');
		/* width: 30px; */
        height: 25px;
		padding-left: 1em;
		padding-right: 1em;
        /* filter: drop-shadow(-2px 3px 0 #81559B); */
    }
    .pauseButton {
        content: url('src/assets/music/pause-light2.svg');
		width: 25px;
		padding-left: 1em;
		padding-right: 1em;
        /* filter: drop-shadow(-2px 3px 0 #81559B); */
    }
    .prev-song-btn{
		width: 100%;
        height: 100%;
        outline: none;
        border: none;
        padding: 0 0 0 5px;
        background:transparent;
        filter: drop-shadow(-2px 3px 0 #81559B);
    }
    .prev-song-btn:hover {
        transform: scale(1.25);
        filter: drop-shadow(0px 0px 10px #E0D3DE);
    }
    .prev-song-btn:active {
        transform: translateY(2px);
        filter: drop-shadow(-2px 2px 0 #81559B);
    }
    .next-song-btn{
		width: 100%;
        height: 100%;
        outline: none;
        border: none;
        background:transparent;
        padding: 0 5px 0 0;
        filter: drop-shadow(-2px 3px 0 #81559B);
    }
    .next-song-btn:hover {
        transform: scale(1.25);
        filter: drop-shadow(0px 0px 10px #E0D3DE);
    }
    .next-song-btn:active {
        transform: translateY(2px);
        filter: drop-shadow(-2px 2px 0 #81559B);
    }
    .play-song-btn{
		width: 100%;
        height: 100%;
        outline: none;
        border: none;
        padding: 0;
        background:transparent;
        filter: drop-shadow(-2px 3px 0 #81559B);
    }
    .play-song-btn:hover {
        transform: scale(1.25);
        filter: drop-shadow(0px 0px 10px #E0D3DE);
    }
    .play-song-btn:active {
        transform: translateY(2px);
        filter: drop-shadow(-2px 2px 0 #81559B);
    }
    .mute-song{
		width: 100%;
        height: 100%;
        outline: none;
        border: none;
        padding: 0 0 0 5px;
        background:transparent;
        filter: drop-shadow(-2px 3px 0 #81559B);
    }
    .mute-song:hover {
        transform: scale(1.25);
        filter: drop-shadow(0px 0px 10px #E0D3DE);
    }
    .mute-song:active {
        transform: translateY(2px);
        filter: drop-shadow(-2px 2px 0 #81559B);
    }
    .backButton {
        content: url('src/assets/music/back-light2.svg');
		height: 20px;
		padding-left: 1em;
		padding-right: 1em;
        /* filter: drop-shadow(-2px 3px 0 #81559B); */
    }
    .nextButton {
        content: url('src/assets/music/forw-light2.svg');
		height: 20px;
		padding-left: 1em;
		padding-right: 1em;
        /* filter: drop-shadow(-2px 3px 0 #81559B); */
    }
    .muteButton {
        content: url('src/assets/music/speaker-light2.svg');
		width: 30px;
		padding-left: 1em;
		padding-right: 1em;
    }
    .speakerButton {
        content: url('src/assets/music/mute-light2.svg');
		width: 30px;
		padding-left: 1em;
		padding-right: 1em;
    }
    .musicBarBox {
        /* background: transparent; */
        background-color: black;
        display: flex;
        /* justify-content: center; */
        border: solid #81559B;
        border-radius: 20px;
        align-items: center;
        justify-content:center;
        padding: 7px;
        width: 70%;
        position: sticky;
    }
	#musicBar {
        -webkit-appearance: none;
        /* width: 35%; */
        width: auto;
        min-width: 30%;
        height: 6px;
        background: #B9D996; 
        border-radius: 5px;
        margin: 10px;
		cursor: url("../assets/cursor/normalLight.cur"), auto;
        display: flex;
        /* justify-content: space-evenly; */
	}
    #musicBar::-webkit-slider-thumb {
        -webkit-appearance: none;
        background-image: url("../assets/solosis.gif");
        background-size: 30px;
        width:30px;
        height:30px;
    }
    #volumeBar {
        -webkit-appearance: none;
        width: 15%;
        height: 15px;
        border: solid 2px;
        border-color: #A585B5;
        border-radius: 5px;
    }
    #volumeBar::-webkit-slider-thumb {
        -webkit-appearance: none;
        width:10px;
        height:20px;
        background: #C9B4CE; 
        border: solid 2px;
        border-color: #C9B4CE #E0D3DE #81559B #A585B5;
    }
    .songNameTitle{
        width:180px;
        border-radius: 15px;
        line-height: 0.75em;
    }
</style>