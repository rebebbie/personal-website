<div class="console" id="consoleID" onclick="focusInputLine()">
    <p class="pixelCons">
        Type <a class="pixelCode">help</a> for a list of commands. 
    </p>
</div>

<script type="text/javascript">
    // let cmd = document.getElementById("cmdLine");
    let userinput;
    let consoleBox = document.getElementById("consoleID");
    let commandStr = "";
    let cmdIndex = 0;

    const cmdList={ 
        "help":{
            cmdDesc: "You are here!",
            run: function() {
                let helpTable = document.createElement("TABLE");
                helpTable.style.textAlign="left";
                helpTable.classList.add("cmdTable");
                let row;
                let col1, col2;
                for(item in cmdList){
                    row = document.createElement("TR");
                    helpTable.appendChild(row);
                    col1 = document.createElement("TD");
                    col1.style.width = "30%";
                    col1.innerHTML = item;
                    col1.classList.add("cmdTableName");
                    col2 = document.createElement("TD");
                    col2.style.color = "#81559B";
                    col2.innerHTML = cmdList[item].cmdDesc;
                    row.appendChild(col1);
                    row.appendChild(col2);
                }
                consoleBox.appendChild(helpTable);
            }
        }, 
        "contact":{
            cmdDesc: "A list of my contacts",
            run: function() {                
                let contTable = document.createElement("TABLE");
                contTable.style.textAlign="left";
                contTable.classList.add("cmdTable");
                let row;
                let col1, col2;

                let socialList = [
                    ["Email", "<a class='pixelEm' href='mailto:rebeccarh228@gmail.com' target='_blank'>Send me an <b>Email</b> at RebeccaRH228@gmail.com</a>"],
                    ["LinkedIn", "<a class='pixelEm' href='https://www.linkedin.com/in/rebecca-ruoxi-han/' target='_blank'>View my <b>LinkedIn</b> profile</a>"],
                    ["GitHub", "<a class='pixelEm' href='https://github.com/rebebbie' target='_blank'>View my projects on <b>GitHub</b></a>"]
                ]

                for(item of socialList){ 
                    row = document.createElement("TR");
                    contTable.appendChild(row);
                    col1 = document.createElement("TD");
                    col1.style.width = "30%";
                    col1.innerHTML = item[0];
                    col1.classList.add("cmdTableName");
                    col2 = document.createElement("TD");
                    col2.innerHTML = item[1];
                    row.appendChild(col1);
                    row.appendChild(col2);
                }
                consoleBox.appendChild(contTable);
            }
        }, 
        "resume":{
            cmdDesc: "Download my resume",
            run: function() {
                let rlink = document.createElement("a");
                rlink.href="src/assets/resume.pdf";
                rlink.download = "Rebecca Han Resume";
                consoleBox.appendChild(rlink);
                // let rlink = document.getElementById("resumeLink");
                rlink.click();
                rlink.remove();
            }
        },  
        "skills":{
            cmdDesc: "View a summary of my skills",
            run: function() {
                 console.log("skills function ran");
            }
        },
        "mainpage data":{
            cmdDesc: "Enter the homepage for my Data Science Portfolio Website",
            run: function() {
                 console.log("mainpage function ran");
            }
        }
    };

    window.addEventListener("load", loadFirstCmd);

    function loadFirstCmd(){
        createNewInputLine();
        userinput = document.getElementById("userInput0");
        userinput.focus();
        userinput.addEventListener("keypress", userType);
    }

    function userType(e){
        if (e.key === "Enter") {
            commandStr=userinput.value;
            checkCommand();
            createNewInputLine();
            userinput.focus();
            userinput.addEventListener("keypress", userType);
        } 
    } 

    function createNewInputLine(){
        let newLine = document.createElement("div");
        let newSpan = document.createElement("span");
        let newContent = document.createElement("input");
        let newSpan2 = document.createElement("span");

        newContent.type="text";
        newContent.classList.add("terminal-input");
        newContent.id = "userInput"+cmdIndex;
        newContent.value="";
        newContent.autocomplete = "off";
        newContent.spellcheck = "false";
        newContent.width = "fit-content";

        newSpan.innerHTML="&gt; ";  
        // newSpan2.innerHTML="&nbsp;";

        newLine.classList.add("command");
        newLine.id = "cmdLine"+cmdIndex;
        newLine.appendChild(newSpan);
        newLine.appendChild(newContent);
        newLine.appendChild(newSpan2);

        consoleBox.appendChild(newLine);
        userinput = document.getElementById("userInput"+cmdIndex);
        cmdIndex++;
    }

    function checkCommand(){
        commandStr = commandStr.trim().toLowerCase();
        
        if(commandStr in cmdList){
            let currCmd = cmdList[commandStr];
            currCmd.run();
        }
        else{
            // no command print
            let noCmdFoundMsg = document.createElement("div");
            noCmdFoundMsg.innerHTML = "<p class='pixelCons'>Command not recognized. Please type <a class='pixelCode'>help</a> for a list of commands!</p>";
            consoleBox.appendChild(noCmdFoundMsg);
            console.log("nop");
        }
    }

    function focusInputLine(){
        userinput.focus();
    }




</script>


<style>

#userInputText{
	-webkit-appearance: none;
	border: none;
	background: black;
}

</style>