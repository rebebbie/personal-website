		filter: drop-shadow(0px 0px 10px #E0D3DE);
	}
	.console {
		background-color: black;
		border-style: solid;
		border-width: 2px;
		border-radius: 8px;
		border-color: #81559B;
		padding: 10px;
		margin-top: 10px;
        margin-bottom: 20px;
	}
    #userInputText{
        -webkit-appearance: none;
        border: none;
        background: black;
    }

</style>