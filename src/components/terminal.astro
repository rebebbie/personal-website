    function userType(e) {
        if (e.key === "Enter") {
            commandStr = userinput.innerHTML;
            console.log(commandStr);
            document.getElementById("blink-space").remove();
            checkCommand();
            createNewInputLine();
            commandStr = "";
            window.scrollTo({
                top: document.body.scrollHeight,
                behavior: "smooth",
            });
        } else if (e.key === "Backspace") {
            console.log(commandStr);
            commandStr = commandStr.slice(0, commandStr.length - 1);
            userinput.innerHTML = commandStr.replaceAll(" ", "&nbsp;");
            // userinput.innerHTML = userinput.innerHTML.slice(0, userinput.innerHTML.length-1);
        } else if (e.key === " ") {
            commandStr = commandStr + " ";
            userinput.innerHTML = userinput.innerHTML + "&nbsp;";
        } else if (isAlphaNumeric(e.key)) {
            commandStr = commandStr + e.key;
            userinput.innerHTML = userinput.innerHTML + e.key;
        }
    }

    function isAlphaNumeric(str) {
        // function obtained from https://stackoverflow.com/questions/4434076/best-way-to-alphanumeric-check-in-javascript
        var code;
        code = str.charCodeAt(0);
        if (str.length > 1) return false;
        if (
            !(code > 47 && code < 58) && // numeric (0-9)
            !(code > 64 && code < 91) && // upper alpha (A-Z)
            !(code > 96 && code < 123)
        ) {
            // lower alpha (a-z)
            return false;
        }
        return true;
    }

